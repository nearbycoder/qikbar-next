---
import Base from '../layouts/Base.astro'
---
<Base title="Not found">
  <section class="container nf">
    <span class="eyebrow">404</span>
    <h1 class="section-title">This page doesn’t exist.</h1>
    <p class="section-lead">Press <kbd data-mod-k>⌘K</kbd> to search for what you were looking for.</p>
    <div style="display:flex;gap:10px;margin-top:28px;justify-content:center">
      <button class="btn btn-primary" type="button" data-qikbar-open>Search</button>
      <a class="btn" href="/">Go home</a>
    </div>
  </section>
</Base>
<style>
  .nf { text-align: center; padding: 140px 0 40px; display: flex; flex-direction: column; align-items: center; }
</style>
