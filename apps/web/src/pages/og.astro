---
import '../styles/global.css'
import Icon from '../components/Icon.astro'
const rows: [string, string, string][] = [
  ['folder', 'Acme Rocket', 'Project'],
  ['credit-card', 'Go to Billing', 'Page'],
  ['sparkles', 'Ask AI “invite sam as admin”', 'AI'],
  ['calculator', '12 × 7 = 84', 'Calculator'],
]
---
<html lang="en" class="dark">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title></head>
  <body>
    <div class="og">
      <div class="glow"></div>
      <div class="left">
        <div class="logo"><span class="mark"><Icon name="search" size={22} /></span> qikbar</div>
        <h1>The command bar<br /><span>your app deserves.</span></h1>
        <p>Open-source ⌘K for any web app. Search, routing, actions, extensions and AI.</p>
        <div class="pills"><span>MIT</span><span>Zero deps</span><span>3.5 KB boot</span></div>
      </div>
      <div class="bar">
        <div class="input"><Icon name="search" size={18} /> <span>acme</span><i></i></div>
        <div class="sec">Results</div>
        {rows.map(([icon, title, kind], i) => (
          <div class={`row${i === 0 ? ' sel' : ''}`}><Icon name={icon as any} size={17} /><b>{title}</b><em>{kind}</em></div>
        ))}
        <div class="foot"><span>Open</span><span class="kbd">↵</span><span class="sep"></span><span>Actions</span><span class="kbd">⌘</span><span class="kbd">.</span></div>
      </div>
    </div>
  </body>
</html>
<style>
  body { margin: 0; background: #08090b; }
  .og { width: 1200px; height: 630px; position: relative; overflow: hidden; display: flex; align-items: center; gap: 56px; padding: 0 72px; box-sizing: border-box;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 48px 48px; }
  .glow { position: absolute; inset: 0; background: radial-gradient(520px 320px at 78% 30%, rgba(52,211,153,.28), transparent 70%), radial-gradient(420px 260px at 20% 90%, rgba(34,211,238,.18), transparent 70%); }
  .left { position: relative; flex: 1; }
  .logo { display: flex; align-items: center; gap: 12px; font-size: 26px; font-weight: 700; letter-spacing: -0.02em; color: #eceef1; }
  .mark { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: linear-gradient(135deg, #34d399, #22d3ee); color: #022c22; }
  h1 { font-size: 62px; line-height: 1.02; letter-spacing: -0.05em; margin: 28px 0 18px; color: #eceef1; }
  h1 span { background: linear-gradient(100deg, #eceef1 10%, #34d399 60%, #22d3ee); -webkit-background-clip: text; background-clip: text; color: transparent; }
  p { font-size: 22px; color: #a0a6af; margin: 0; max-width: 480px; line-height: 1.4; }
  .pills { display: flex; gap: 10px; margin-top: 28px; }
  .pills span { padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); color: #cfd3d8; font-size: 16px; }
  .bar { position: relative; width: 470px; flex-shrink: 0; border-radius: 18px; background: rgba(24,26,30,.92); border: 1px solid rgba(255,255,255,.1); box-shadow: 0 40px 100px -20px rgba(0,0,0,.8), 0 0 80px -20px rgba(52,211,153,.35); padding-bottom: 6px; color: #eceef1; font-family: var(--font); }
  .input { display: flex; align-items: center; gap: 12px; height: 64px; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.08); font-size: 20px; color: #6b717b; }
  .input span { color: #eceef1; }
  .input i { width: 2px; height: 24px; background: #34d399; margin-left: -8px; }
  .sec { font-size: 13px; color: #6b717b; font-weight: 600; padding: 14px 22px 6px; }
  .row { display: flex; align-items: center; gap: 14px; margin: 0 8px; padding: 0 14px; height: 50px; border-radius: 10px; font-size: 17px; color: #a0a6af; }
  .row b { font-weight: 500; color: #eceef1; }
  .row em { margin-left: auto; font-style: normal; font-size: 14px; color: #6b717b; }
  .row.sel { background: rgba(255,255,255,.07); }
  .foot { display: flex; align-items: center; justify-content: flex-end; gap: 6px; height: 50px; margin-top: 10px; padding: 0 16px; border-top: 1px solid rgba(255,255,255,.08); font-size: 14px; color: #a0a6af; }
  .foot .kbd { height: 22px; min-width: 22px; font-size: 12px; background: rgba(255,255,255,.06); color: #a0a6af; border-color: rgba(255,255,255,.12); }
  .foot .sep { width: 1px; height: 16px; background: rgba(255,255,255,.12); margin: 0 6px; }
</style>
