---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import ExtIcon from '../components/ExtIcon.astro'
import { catalog, CATEGORIES } from '../data/extensions'

const sources = import.meta.glob<string>('../extensions/*.ts', { query: '?raw', import: 'default', eager: true })
const sourceOf = (file: string) => sources[`../extensions/${file}`] ?? ''

const builtIns = [
  { icon: 'calculator', title: 'Calculator', fn: 'calculator()', body: 'Math, percentages and unit conversions as you type.', try: '15% of 240' },
  { icon: 'palette', title: 'Theme switcher', fn: 'themeSwitcher()', body: 'Toggle dark mode with ⌘⇧L, or choose light, dark or system.', try: 'dark mode' },
  { icon: 'file', title: 'Page', fn: 'page()', body: 'Jump to headings on the page, copy the URL, go back, print or share.', try: 'copy page url' },
  { icon: 'sparkles', title: 'AI actions', fn: 'aiActions()', body: 'Summarize the page, explain selected text, translate.', try: 'summarize' },
  { icon: 'keyboard', title: 'Shortcuts', fn: 'shortcuts()', body: 'A searchable cheat sheet of every keyboard shortcut.', try: 'keyboard shortcuts' },
  { icon: 'key', title: 'AI settings', fn: 'byok.settings()', body: 'Let users bring their own Anthropic, OpenAI or Gemini key.', try: 'ai settings' },
]

const repo = 'https://github.com/nearbycoder/qikbar-next/blob/main/apps/web/src/extensions'
---

<Base title="Extensions" description="Built-in and community extensions for Qikbar: commands, sources, AI tools and preferences in portable packages.">
  <section class="container head">
    <span class="eyebrow"><Icon name="puzzle" size={14} /> Extensions</span>
    <h1 class="section-title" style="font-size: clamp(36px, 5vw, 56px)">Extend the bar with anything.</h1>
    <p class="section-lead">An extension bundles commands, live sources, AI tools and preferences. Each one below is a single readable file. Install it into this site's bar with one click, then press <kbd data-mod-k>⌘K</kbd>.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/docs/extensions">Build an extension <Icon name="arrow-right" size={15} /></a>
      <a class="btn" href="/docs/publishing-extensions">Publish yours</a>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Examples <span>{catalog.length} extensions · install them here, copy them into your app</span></h2>
      <div class="filters">
        <div class="chips" role="radiogroup" aria-label="Category">
          <button type="button" role="radio" aria-checked="true" data-cat="">All</button>
          {CATEGORIES.map((c) => <button type="button" role="radio" aria-checked="false" data-cat={c}>{c}</button>)}
        </div>
        <label class="filter-search"><Icon name="search" size={14} /><input type="search" placeholder="Filter extensions…" data-filter aria-label="Filter extensions" /></label>
      </div>
    </div>
    <p class="none" data-none hidden>No extensions match.</p>
    <div class="cards">
      {catalog.map((c) => (
        <article class="ext" data-ext={c.extension.name} data-category={c.category} data-text={`${c.extension.title} ${c.extension.description} ${c.tags.join(' ')} ${c.category}`.toLowerCase()}>
          <div class="ext-top">
            <ExtIcon class="tile" icon={c.extension.icon} size={22} />
            <div class="titles">
              <h3>{c.extension.title}</h3>
              <div class="meta">
                <span class="cat">{c.category}</span>
                {c.uses && <><span class="dot" aria-hidden="true"></span><span>{c.uses}</span></>}
              </div>
            </div>
            <button class="install" type="button" data-install={c.extension.name} aria-pressed="false" aria-label={`Install ${c.extension.title}`}>
              <span class="when-off"><Icon name="plus" size={14} /> Install</span>
              <span class="when-on"><Icon name="check" size={14} /> Installed</span>
            </button>
          </div>
          <p class="desc">{c.extension.description}</p>
          <ul class="features" aria-label="API features used">
            {c.tags.map((t) => <li>{t}</li>)}
          </ul>
          <div class="ext-actions">
            <button type="button" class="try" data-try={c.try}>
              <Icon name="search" size={14} />
              <span class="q">{c.try}</span>
              <span class="go">Try it <Icon name="arrow-right" size={13} /></span>
            </button>
            <button type="button" class="view" data-source={c.file} aria-haspopup="dialog"><Icon name="code" size={14} /> Source</button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container block">
    <h2>Built in <span>Import from <code>@qikbar/qikbar/extensions</code>. Already installed on this site.</span></h2>
    <div class="cards small">
      {builtIns.map((b) => (
        <article class="ext builtin">
          <div class="ext-top">
            <ExtIcon class="tile" icon={b.icon} size={20} />
            <div class="titles">
              <h3>{b.title}</h3>
              <code class="fn">{b.fn}</code>
            </div>
          </div>
          <p class="desc">{b.body}</p>
          <div class="ext-actions">
            <button type="button" class="try" data-try={b.try}>
              <Icon name="search" size={14} />
              <span class="q">{b.try}</span>
              <span class="go">Try it <Icon name="arrow-right" size={13} /></span>
            </button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container block">
    <div class="submit card">
      <div>
        <h2 style="margin:0">Built something useful?</h2>
        <p>Publish it to npm with the <code>qikbar-extension</code> keyword and open a pull request to list it here.</p>
      </div>
      <div class="actions" style="margin:0">
        <a class="btn btn-primary" href="/docs/publishing-extensions">Publishing guide</a>
        <a class="btn" href="/docs/example-extensions">Walk through the examples</a>
      </div>
    </div>
  </section>

  <dialog class="source-dialog" data-source-dialog aria-labelledby="source-title">
    <div class="sd-head">
      <Icon name="file-text" size={15} />
      <strong id="source-title" data-source-title></strong>
      <div class="sd-tools">
        <button type="button" class="sd-btn" data-source-copy><Icon name="copy" size={13} /> Copy</button>
        <a class="sd-btn" data-source-link href="#" target="_blank" rel="noopener"><Icon name="github" size={13} /> GitHub</a>
        <button type="button" class="sd-btn icon" data-source-close aria-label="Close" autofocus><Icon name="x" size={15} /></button>
      </div>
    </div>
    <div class="sd-body">
      {catalog.map((c) => (
        <div class="sd-file" data-file={c.file} data-href={`${repo}/${c.file}`} hidden>
          <Code code={sourceOf(c.file)} lang="ts" themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
        </div>
      ))}
    </div>
  </dialog>
</Base>

<script>
  import { installedNames } from '../data/extensions'

  const sync = () => {
    const installed = new Set(installedNames())
    document.querySelectorAll<HTMLButtonElement>('[data-install]').forEach((b) => {
      const on = installed.has(b.dataset.install!)
      b.setAttribute('aria-pressed', String(on))
      b.closest('.ext')?.classList.toggle('installed', on)
    })
  }
  sync()

  document.querySelectorAll<HTMLButtonElement>('[data-install]').forEach((b) =>
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true'
      window.qikbarSetInstalled(b.dataset.install!, on)
      sync()
      window.qikbar.toast({ title: on ? 'Installed. Press ⌘K to try it.' : 'Uninstalled', style: 'success' })
    }),
  )

  document.querySelectorAll<HTMLButtonElement>('[data-try]').forEach((b) =>
    b.addEventListener('click', () => {
      const card = b.closest<HTMLElement>('[data-ext]')
      if (card) {
        window.qikbarSetInstalled(card.dataset.ext!, true)
        sync()
      }
      window.qikbar.open({ query: b.dataset.try })
    }),
  )

  // Filters
  const cards = [...document.querySelectorAll<HTMLElement>('.ext[data-category]')]
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')]
  const search = document.querySelector<HTMLInputElement>('[data-filter]')!
  let cat = ''
  const apply = () => {
    const q = search.value.trim().toLowerCase()
    let shown = 0
    for (const c of cards) {
      const ok = (!cat || c.dataset.category === cat) && (!q || q.split(/\s+/).every((w) => c.dataset.text!.includes(w)))
      c.hidden = !ok
      if (ok) shown++
    }
    document.querySelector<HTMLElement>('[data-none]')!.hidden = shown > 0
  }
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      cat = chip.dataset.cat ?? ''
      chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)))
      apply()
    }),
  )
  search.addEventListener('input', apply)

  // Source viewer
  const dialog = document.querySelector<HTMLDialogElement>('[data-source-dialog]')!
  const files = [...dialog.querySelectorAll<HTMLElement>('.sd-file')]
  let current: HTMLElement | undefined
  document.querySelectorAll<HTMLButtonElement>('[data-source]').forEach((b) =>
    b.addEventListener('click', () => {
      current = files.find((f) => f.dataset.file === b.dataset.source)
      files.forEach((f) => (f.hidden = f !== current))
      dialog.querySelector('[data-source-title]')!.textContent = b.dataset.source!
      dialog.querySelector<HTMLAnchorElement>('[data-source-link]')!.href = current?.dataset.href ?? '#'
      dialog.showModal()
      dialog.querySelector('.sd-body')!.scrollTop = 0
    }),
  )
  dialog.querySelector('[data-source-close]')!.addEventListener('click', () => dialog.close())
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })
  dialog.querySelector('[data-source-copy]')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(current?.querySelector('pre')?.innerText ?? '')
    window.qikbar.toast({ title: 'Source copied', style: 'success' })
  })
</script>

<style>
  .head { padding-top: 72px; }
  .actions { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
  .block { margin-top: 72px; }
  .block h2 { font-size: 22px; letter-spacing: -0.02em; margin: 0 0 20px; display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .block h2 span { font-size: 14px; font-weight: 400; color: var(--subtle); }
  .block-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
  .block-head h2 { margin: 0; }
  .filters { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chips button { height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--panel); color: var(--muted); font: 500 13px var(--font); cursor: pointer; }
  .chips button[aria-checked='true'] { border-color: var(--brand); color: var(--text); background: var(--brand-soft); }
  .filter-search { display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-soft); color: var(--subtle); min-width: 240px; }
  .filter-search input { border: 0; outline: 0; background: none; color: var(--text); font: 14px var(--font); width: 100%; }
  .none { color: var(--muted); }
  .tags .cat { color: var(--brand); border-color: color-mix(in srgb, var(--brand) 30%, transparent); background: var(--brand-soft); font-family: var(--font); }
  .tags .uses { font-family: var(--font); }
  .ext[hidden] { display: none; }
  .submit { padding: 28px 32px; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: radial-gradient(400px 160px at 0% 0%, color-mix(in srgb, var(--brand) 12%, transparent), transparent 70%), var(--panel); }
  .submit p { color: var(--muted); margin: 6px 0 0; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .cards.small { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 960px) { .cards.small { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .cards, .cards.small { grid-template-columns: 1fr; } }

  .ext { position: relative; display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 22px; border-radius: 16px; border: 1px solid var(--border); background: linear-gradient(180deg, color-mix(in srgb, var(--text) 2%, var(--panel)), var(--panel)); transition: border-color .2s, transform .2s, box-shadow .2s; }
  .ext:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow); }
  .ext.installed { border-color: color-mix(in srgb, var(--brand) 40%, transparent); }
  .ext.installed::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(300px 120px at 0% 0%, color-mix(in srgb, var(--brand) 9%, transparent), transparent 70%); }

  .ext-top { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .ext :global(.tile) { width: 46px; height: 46px; border-radius: 13px; background: linear-gradient(145deg, color-mix(in srgb, var(--brand) 16%, var(--bg-soft)), var(--bg-soft)); border: 1px solid color-mix(in srgb, var(--brand) 22%, var(--border)); box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent); font-size: 22px; }
  .titles { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .ext h3 { margin: 0; font-size: 16.5px; letter-spacing: -0.01em; line-height: 1.25; }
  .meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--subtle); white-space: nowrap; overflow: hidden; }
  .meta .cat { color: var(--brand); font-weight: 550; }
  .meta .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--subtle); flex-shrink: 0; }
  .fn { font-size: 12.5px; color: var(--subtle); }

  .desc { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; }
  .features { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .features li { font: 500 11.5px var(--mono); padding: 3px 8px; border-radius: 6px; background: color-mix(in srgb, var(--text) 4%, transparent); color: var(--muted); }

  .install { flex-shrink: 0; display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: 9px; border: 1px solid var(--border-strong); background: var(--panel); color: var(--text); font: 500 13px var(--font); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
  .install:hover { border-color: var(--brand); }
  .install span { display: inline-flex; align-items: center; gap: 6px; }
  .install .when-on { display: none; }
  .install[aria-pressed='true'] { border-color: transparent; background: var(--brand-soft); color: var(--brand); }
  .install[aria-pressed='true'] .when-on { display: inline-flex; }
  .install[aria-pressed='true'] .when-off { display: none; }

  .ext-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border); }
  .try { flex: 1; min-width: 0; display: flex; align-items: center; gap: 9px; height: 38px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-soft); color: var(--subtle); font: 13.5px var(--font); cursor: pointer; text-align: left; transition: border-color .15s, color .15s; }
  .try .q { flex: 1; min-width: 0; color: var(--text); font-family: var(--mono); font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .try .go { display: inline-flex; align-items: center; gap: 4px; color: var(--subtle); font-weight: 550; font-size: 12.5px; white-space: nowrap; transition: color .15s, gap .15s; }
  .try:hover { border-color: var(--brand); }
  .try:hover .go { color: var(--brand); gap: 7px; }
  .view { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 10px; border: 1px solid var(--border); background: transparent; color: var(--muted); font: 500 13px var(--font); cursor: pointer; white-space: nowrap; }
  .view:hover { color: var(--text); border-color: var(--border-strong); }

  .builtin { padding: 20px; }
  .builtin :global(.tile) { width: 40px; height: 40px; border-radius: 11px; }

  .source-dialog { width: min(860px, calc(100vw - 32px)); max-height: min(80vh, 760px); padding: 0; border: 1px solid var(--border-strong); border-radius: 16px; background: var(--panel); color: var(--text); box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); overflow: hidden; }
  .source-dialog[open] { display: flex; flex-direction: column; animation: sd-in .18s ease-out; }
  .source-dialog::backdrop { background: rgba(0,0,0,.5); backdrop-filter: blur(4px); }
  @keyframes sd-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
  .sd-head { display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 18px; border-bottom: 1px solid var(--border); color: var(--muted); }
  .sd-head strong { color: var(--text); font: 600 14px var(--mono); }
  .sd-tools { margin-left: auto; display: flex; gap: 6px; }
  .sd-btn { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-soft); color: var(--muted); font: 500 12.5px var(--font); text-decoration: none; cursor: pointer; }
  .sd-btn:hover { color: var(--text); }
  .sd-btn.icon { padding: 0 7px; }
  .sd-body { overflow: auto; }
  .sd-body :global(.astro-code) { margin: 0; border: 0; border-radius: 0; font-size: 12.5px; padding: 18px 20px; }
</style>
