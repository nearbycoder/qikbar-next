---
import Base from './Base.astro'
import Icon from '../components/Icon.astro'
import { allDocs, hrefOf, sidebar, type Doc } from '../lib/docs'

interface Props {
  doc: Doc
  headings: { depth: number; slug: string; text: string }[]
}
const { doc, headings } = Astro.props
const groups = await sidebar()
const flat = await allDocs()
const index = flat.findIndex((d) => d.id === doc.id)
const prev = flat[index - 1]
const next = flat[index + 1]
const current = hrefOf(doc)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const mdHref = doc.id === 'index' ? '/docs/index.md' : `/docs/${doc.id}.md`
const editHref = `https://github.com/nearbycoder/qikbar-next/edit/main/apps/web/src/content/docs/${doc.id}.md`
---
<Base title={doc.data.title} description={doc.data.description}>
  <div class="docs container">
    <aside class="sidebar" aria-label="Documentation">
      <button class="sidebar-search" type="button" data-qikbar-open data-qikbar-query="">
        <Icon name="search" size={14} /> Search docs <span class="kbd" data-mod-k>⌘K</span>
      </button>
      {groups.map((g) => (
        <div class="group">
          <div class="group-title">{g.group}</div>
          <ul>
            {g.items.map((d) => (
              <li><a href={hrefOf(d)} aria-current={hrefOf(d) === current ? 'page' : undefined}>{d.data.label ?? d.data.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <article class="content">
      <div class="crumbs">{doc.data.group}</div>
      <h1>{doc.data.title}</h1>
      <p class="lead">{doc.data.description}</p>
      <div class="page-actions">
        <button type="button" class="pa" data-copy-md={mdHref}><Icon name="copy" size={13} /> Copy as Markdown</button>
        <a class="pa" href={mdHref}><Icon name="file-text" size={13} /> View .md</a>
        <a class="pa" href={`https://claude.ai/new?q=${encodeURIComponent(`Read ${new URL(mdHref, Astro.site)} and help me use Qikbar.`)}`} target="_blank" rel="noopener"><Icon name="sparkles" size={13} /> Open in Claude</a>
        <a class="pa" href={`https://chatgpt.com/?q=${encodeURIComponent(`Read ${new URL(mdHref, Astro.site)} and help me use Qikbar.`)}`} target="_blank" rel="noopener"><Icon name="message" size={13} /> Open in ChatGPT</a>
      </div>
      <div class="prose">
        <slot />
      </div>
      <nav class="pager" aria-label="Pagination">
        {prev ? <a href={hrefOf(prev)} class="prev"><span>Previous</span>{prev.data.title}</a> : <span />}
        {next ? <a href={hrefOf(next)} class="next"><span>Next</span>{next.data.title}</a> : <span />}
      </nav>
      <a class="edit" href={editHref}><Icon name="pencil" size={13} /> Edit this page on GitHub</a>
    </article>

    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <>
          <div class="toc-title">On this page</div>
          <ul>
            {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </>
      )}
    </aside>
  </div>
</Base>

<script>
  const embed = document.querySelector<HTMLElement>('[data-prompt-embed]')
  if (embed) {
    fetch('/prompt.txt')
      .then((r) => r.text())
      .then((text) => {
        const pre = document.createElement('pre')
        pre.className = 'prompt-pre'
        pre.textContent = text
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'btn btn-brand prompt-copy'
        btn.textContent = 'Copy prompt'
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(text)
          window.qikbar.toast({ title: 'Prompt copied', message: 'Paste it into your coding agent', style: 'success' })
        })
        embed.append(btn, pre)
      })
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy-md]').forEach((b) =>
    b.addEventListener('click', async () => {
      const md = await fetch(b.dataset.copyMd!).then((r) => r.text())
      await navigator.clipboard.writeText(md)
      window.qikbar.toast({ title: 'Copied page as Markdown', style: 'success' })
    }),
  )
  // Highlight the current TOC entry.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')]
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[]
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        links.forEach((a) => a.classList.toggle('active', a.hash === `#${e.target.id}`))
      }
    },
    { rootMargin: '-80px 0px -70% 0px' },
  )
  targets.forEach((t) => io.observe(t))
</script>

<style>
  .docs { display: grid; grid-template-columns: 230px minmax(0, 1fr) 210px; gap: 48px; padding-top: 36px; }
  .sidebar, .toc { position: sticky; top: calc(var(--header) + 24px); align-self: start; max-height: calc(100vh - var(--header) - 48px); overflow-y: auto; scrollbar-width: thin; padding-bottom: 32px; }
  .sidebar-search { width: 100%; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 8px 0 10px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-soft); color: var(--subtle); font: 13.5px var(--font); cursor: pointer; margin-bottom: 22px; }
  .sidebar-search .kbd { margin-left: auto; font-size: 11px; }
  .group { margin-bottom: 22px; }
  .group-title { font-size: 12.5px; font-weight: 600; color: var(--text); margin-bottom: 6px; padding-left: 10px; }
  .sidebar ul { list-style: none; margin: 0; padding: 0; }
  .sidebar li a { display: block; padding: 5px 10px; border-radius: 7px; font-size: 14px; color: var(--muted); text-decoration: none; }
  .sidebar li a:hover { color: var(--text); background: var(--bg-soft); }
  .sidebar li a[aria-current='page'] { color: var(--brand); background: var(--brand-soft); font-weight: 500; }
  .content { min-width: 0; max-width: 760px; padding-bottom: 40px; }
  .crumbs { color: var(--brand); font-size: 13px; font-weight: 600; }
  .content h1 { font-size: clamp(32px, 4vw, 42px); letter-spacing: -0.035em; line-height: 1.1; margin: 8px 0 12px; }
  .lead { font-size: 18px; color: var(--muted); margin: 0 0 18px; }
  .page-actions { display: flex; flex-wrap: wrap; gap: 6px; padding-bottom: 26px; margin-bottom: 30px; border-bottom: 1px solid var(--border); }
  .pa { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 7px; border: 1px solid var(--border); background: var(--panel); color: var(--muted); font: 500 12.5px var(--font); text-decoration: none; cursor: pointer; }
  .pa:hover { color: var(--text); border-color: var(--border-strong); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; }
  .pager a { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px; text-decoration: none; font-weight: 550; }
  .pager a:hover { border-color: var(--border-strong); }
  .pager span { font-size: 12.5px; color: var(--subtle); font-weight: 400; }
  .pager .next { text-align: right; }
  .edit { display: inline-flex; gap: 6px; align-items: center; margin-top: 24px; font-size: 13px; color: var(--subtle); text-decoration: none; }
  .edit:hover { color: var(--muted); }
  .toc-title { font-size: 12.5px; font-weight: 600; margin-bottom: 8px; }
  .toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
  .toc li a { display: block; padding: 4px 0 4px 12px; margin-left: -1px; border-left: 1px solid transparent; font-size: 13px; color: var(--subtle); text-decoration: none; line-height: 1.4; }
  .toc li.d3 a { padding-left: 24px; }
  .toc li a:hover { color: var(--text); }
  .toc li a.active { color: var(--brand); border-left-color: var(--brand); }
  @media (max-width: 1180px) { .docs { grid-template-columns: 220px minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 820px) { .docs { grid-template-columns: 1fr; } .sidebar { position: static; max-height: none; display: none; } }

  .prose { font-size: 16px; line-height: 1.75; }
  .prose :global(h2) { font-size: 24px; letter-spacing: -0.025em; margin: 52px 0 12px; line-height: 1.25; }
  .prose :global(h3) { font-size: 18px; letter-spacing: -0.015em; margin: 34px 0 8px; }
  .prose :global(h2 a), .prose :global(h3 a) { text-decoration: none; }
  .prose :global(p) { margin: 0 0 18px; color: color-mix(in srgb, var(--text) 86%, var(--muted)); }
  .prose :global(a) { color: var(--brand); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--brand) 35%, transparent); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin: 0 0 18px; }
  .prose :global(li) { margin: 5px 0; }
  .prose :global(li::marker) { color: var(--subtle); }
  .prose :global(:not(pre) > code) { font-size: 0.86em; padding: 0.15em 0.4em; border-radius: 6px; background: var(--bg-soft); border: 1px solid var(--border); }
  .prose :global(pre) { margin: 0 0 22px; }
  .prose :global(.code-wrap) { margin: 0 0 22px; }
  .prose :global(.code-wrap pre) { margin: 0; }
  .prose :global(blockquote) { margin: 0 0 20px; padding: 12px 16px; border-left: 3px solid var(--brand); background: var(--brand-soft); border-radius: 0 10px 10px 0; }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14px; }
  @media (max-width: 900px) { .prose :global(table) { display: block; overflow-x: auto; } }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .prose :global(th) { font-weight: 600; font-size: 13px; color: var(--muted); }
  .prose :global(td code) { white-space: nowrap; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 40px 0; }
  .prose :global(img) { border-radius: 12px; border: 1px solid var(--border); }
  .prose :global(.prompt-embed) { position: relative; margin: 0 0 22px; }
  .prose :global(.prompt-pre) { margin: 0; max-height: 420px; overflow: auto; white-space: pre-wrap; padding: 18px 20px; border-radius: 12px; border: 1px solid var(--border); background: var(--code-bg); font-size: 13px; line-height: 1.65; color: var(--muted); }
  .prose :global(.prompt-copy) { position: absolute; top: 10px; right: 10px; height: 34px; font-size: 13.5px; }
</style>
