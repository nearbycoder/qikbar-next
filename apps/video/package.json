{
  "name": "@qikbar/video",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "bun run scripts/audio.ts",
    "studio": "remotion studio src/index.ts",
    "render": "bun run audio && remotion render src/index.ts Main out/qikbar.mp4 --codec=h264 --crf=20 --audio-codec=aac --audio-bitrate=192k",
    "still": "remotion still src/index.ts Main out/poster.jpg --frame=520",
    "preview-frames": "bun run scripts/frames.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@qikbar/qikbar": "workspace:*",
    "@remotion/cli": "4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535"
  }
}
