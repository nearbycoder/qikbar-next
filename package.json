{
  "name": "qikbar-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "scripts": {
    "build": "bun run --filter qikbar build && bun run --filter @qikbar/web build",
    "build:lib": "bun run --filter qikbar build",
    "dev": "bun run --filter @qikbar/web dev",
    "test": "bun run --filter qikbar test",
    "typecheck": "bun run --filter qikbar typecheck"
  },
  "packageManager": "bun@1.4.2"
}
